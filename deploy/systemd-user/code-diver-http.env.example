# Environment for code-diver-http@<project>.service
# Install as ~/.config/code-diver/<project>.http.env with mode 0600.
# Values here override the unit defaults. OAuth and TLS are OFF by default:
# leave the commented lines alone to keep the previous behaviour.

# --- listen ---------------------------------------------------------------
# CODE_DIVER_MCP_HOST=127.0.0.1
# CODE_DIVER_HTTP_PORT=18080
# CODE_DIVER_CORS_ORIGINS=https://app.example.internal

# --- OAuth 2.1 (recommended whenever the port is reachable by others) -----
# CODE_DIVER_OAUTH_ENABLED=1
# CODE_DIVER_OAUTH_ISSUER=https://mcp.example.internal:18080
# CODE_DIVER_OAUTH_JWT_SECRET_FILE=/home/USER/.config/code-diver/oauth-jwt.secret
# CODE_DIVER_OAUTH_CONSENT_SECRET=change-me-operator-code
# CODE_DIVER_OAUTH_DB=/home/USER/.local/share/code-diver/oauth.sqlite3
# CODE_DIVER_OAUTH_ACCESS_TTL=900
# CODE_DIVER_OAUTH_REFRESH_TTL=2592000
# CODE_DIVER_OAUTH_PROTECT_REST=1

# --- TLS ------------------------------------------------------------------
# CODE_DIVER_TLS_CERT=/home/USER/.config/code-diver/tls/server.pem
# CODE_DIVER_TLS_KEY=/home/USER/.config/code-diver/tls/server.key
# CODE_DIVER_TLS_CLIENT_CA=/home/USER/.config/code-diver/tls/client-ca.pem
# CODE_DIVER_TLS_REQUIRE_CLIENT_CERT=0

# --- MCP session limits ---------------------------------------------------
# CODE_DIVER_MCP_MAX_SESSIONS=256
# CODE_DIVER_MCP_SESSION_IDLE=1800
# CODE_DIVER_MCP_SSE_PING=15
# CODE_DIVER_MCP_MAX_BODY=4194304
